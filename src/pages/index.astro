---
import BaseLayout from '@/layouts/base-layout.astro';
import { EditorToolbar, LazyEditorPreview, EditorLibrarySidebar, EditorSettingsSidebar } from '@/modules/editor-shell';
---

<BaseLayout>
  <main class="flex h-screen w-screen flex-col overflow-hidden bg-canvas text-fg">
    <EditorToolbar client:only="react" />
    <div class="flex min-h-0 flex-1 overflow-hidden">
      <EditorLibrarySidebar client:only="react" />
      <LazyEditorPreview client:only="react" />
      <EditorSettingsSidebar client:only="react" />
    </div>
  </main>
</BaseLayout>
