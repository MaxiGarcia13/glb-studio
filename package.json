{
  "name": "three-editor",
  "type": "module",
  "version": "0.0.1",
  "description": "A browser-native GLB character & animation editor — load or build characters, shape their motion, and ship clean GLBs without leaving the tab.",
  "author": "Maximiliano Garcia Mortigliengo",
  "license": "Apache-2.0",
  "homepage": "https://github.com/MaxiGarcia13/three-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiGarcia13/three-editor.git"
  },
  "bugs": {
    "url": "https://github.com/MaxiGarcia13/three-editor/issues"
  },
  "scripts": {
    "prepare": "husky || true",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "clean": "rm -rf .astro node_modules .next .vercel package-lock.json",
    "phoenix": "npm run clean && npm i",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/react": "6.0.6",
    "@astrojs/vercel": "11.0.10",
    "@maxigarcia/js-utils": "1.15.0",
    "@nanostores/react": "2.0.1",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "astro": "7.3.3",
    "fbx2gltf": "0.9.7-p1",
    "jszip": "3.10.2",
    "nanostores": "1.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.19.1",
    "@maxigarcia/eslint-config": "^1.14.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.1"
  }
}
